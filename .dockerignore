# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
!**/*.hcl
!**/*.tmpl
!**/*.cel
!internal/authorization/*.cedar
!internal/workflow/input-schema.json
!internal/controller/agent/prompts/
!internal/gateway/prompts/
!internal/launcher/codex_prompt.gen.md
!internal/**/db/migrations/*.sql
**/*_test.go
**/node_modules/**
.ref/**

# Re-include Go module files
!go.mod
!go.sum

# Re-include nix init script used by Dockerfile.nix-init
!hack/nix-init.sh

!Dockerfile.browser
!opencode/
!opencode/browser/
!opencode/browser/*.ts
!opencode/browser/package.json
!opencode/browser/bun.lock
!opencode/config/
!opencode/config/lib/
!opencode/config/lib/gateway/
!opencode/config/lib/gateway/client/
!opencode/config/lib/gateway/client/*.ts

# Keep dependency trees, tests and local build output outside the worker image.
opencode/**/node_modules/**
opencode/browser/dist/**
opencode/browser/*.test.ts
