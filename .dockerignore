# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
!**/*.hcl
!**/*.tmpl
!internal/authorization/*.cedar
!internal/workflow/input-schema.json
!internal/controller/agent/prompts/
!internal/inference/chat-text-content.cel
!internal/**/db/migrations/*.sql
**/*_test.go
**/node_modules/**
.ref/**

# Re-include Go module files
!go.mod
!go.sum

# Re-include nix init script used by Dockerfile.nix-init
!hack/nix-init.sh

# Internal grading sidecar
!evaluator/package.json
!evaluator/bun.lock
!evaluator/server.ts
!evaluator/client/*.ts
