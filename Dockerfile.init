FROM nixos/nix:2.32.8 AS nix

FROM debian:trixie-slim

COPY --from=nix /nix /nix
COPY --from=nix /etc/nix /etc/nix

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates bash coreutils xz-utils && rm -rf /var/lib/apt/lists/*

RUN ln -sf /nix/var/nix/profiles/default /root/.nix-profile \
    && echo "experimental-features = nix-command flakes" >> /etc/nix/nix.conf \
    && echo "sandbox = false" >> /etc/nix/nix.conf

ENV PATH="/root/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV NIX_PROFILES="/nix/var/nix/profiles/default /root/.nix-profile"
ENV NIX_SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"

COPY hack/nix-init.sh /usr/local/bin/nix-init.sh
RUN chmod +x /usr/local/bin/nix-init.sh

ENTRYPOINT ["/usr/local/bin/nix-init.sh"]
