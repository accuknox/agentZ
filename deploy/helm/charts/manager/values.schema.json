{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "enabled": { "type": "boolean" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "storeName": { "type": "string" },
            "refreshInterval": { "type": "string", "minLength": 1 },
            "serviceAccount": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "namespace": { "type": "string" },
                "annotations": { "type": "object" },
                "audiences": { "type": "array", "items": { "type": "string" } }
              }
            },
            "openBao": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "server": { "type": "string" },
                "kvMount": { "type": "string" },
                "kubernetesAuthMount": { "type": "string" },
                "role": { "type": "string" },
                "caBundle": { "type": "string" },
                "caProvider": { "type": "object" }
              }
            },
            "managedNamespaceSelector": { "type": "object" }
          }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "strategy": { "$ref": "#/definitions/strategy" },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "logFormat": { "enum": ["text", "json", "pretty"] },
        "logWithSource": { "type": "boolean" },
        "metricsBindAddress": { "type": "string" },
        "healthProbeBindAddress": { "type": "string" },
        "leaderElect": { "type": "boolean" },
        "metricsSecure": { "type": "boolean" },
        "enableHTTP2": { "type": "boolean" },
        "workflowRunOrphanRetention": { "type": "string" },
        "controllerImage": { "type": "string", "minLength": 1 },
        "agentImage": { "type": "string" },
        "agentInitImage": { "type": "string" },
        "gatewayURL": { "type": "string" },
        "agentgatewayTraceMode": { "enum": ["service", "static"] },
        "agentgatewayTraceServiceName": { "type": "string" },
        "agentgatewayTraceServiceNamespace": { "type": "string" },
        "agentgatewayTraceServicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "agentgatewayTraceHost": { "type": "string" },
        "agentgatewayTracePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nixStorePVC": { "type": "string", "minLength": 1 },
        "nixStoreSize": { "type": "string", "minLength": 1 },
        "nixStoreAccessModes": { "type": "array", "minItems": 1, "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] } },
        "nixStoreStorageClass": { "type": "string" },
        "nixCacheEndpoint": { "type": "string", "minLength": 1 },
        "skillsS3Endpoint": { "type": "string", "minLength": 1 },
        "skillsS3Region": { "type": "string", "minLength": 1 },
        "skillsS3Bucket": { "type": "string", "minLength": 1 },
        "skillsS3AccessKeyIDSecretName": { "type": "string", "minLength": 1 },
        "skillsS3AccessKeyIDSecretKey": { "type": "string", "minLength": 1 },
        "skillsS3SecretAccessKeySecretName": { "type": "string", "minLength": 1 },
        "skillsS3SecretAccessKeySecretKey": { "type": "string", "minLength": 1 },
        "openBaoAddr": { "type": "string", "minLength": 1 },
        "managerOpenBaoAddr": { "type": "string" },
        "openBaoSecretMountPath": { "type": "string", "minLength": 1 },
        "openBaoK8sAuthMountPath": { "type": "string", "minLength": 1 },
        "sinjectorOpenBaoK8sAuthTokenPath": { "type": "string", "minLength": 1 },
        "managerOpenBaoK8sAuthRole": { "type": "string", "minLength": 1 },
        "managerOpenBaoK8sAuthTokenPath": { "type": "string", "minLength": 1 },
        "managerGatewayTokenPath": { "type": "string", "minLength": 1 },
        "managerGatewayTokenAudience": { "type": "string", "minLength": 1 },
        "gatewayServiceAccountName": { "type": "string" },
        "gatewayServiceAccountNamespace": { "type": "string" },
        "sinjectorCASecretName": { "type": "string", "minLength": 1 },
        "sinjectorCASecretCertKey": { "type": "string", "minLength": 1 },
        "sinjectorCASecretKeyKey": { "type": "string", "minLength": 1 },
        "sinjectorCASecretBundleKey": { "type": "string", "minLength": 1 },
        "sinjectorCACertPath": { "type": "string", "minLength": 1 },
        "sinjectorCAKeyPath": { "type": "string", "minLength": 1 },
        "agentCABundlePath": { "type": "string", "minLength": 1 },
        "tenantSinjectorClusterIssuerName": { "type": "string", "minLength": 1 },
        "tenantAgentQuota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "resources", "defaults"],
          "properties": {
            "count": { "type": "integer", "minimum": 1 },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": { "type": "string", "minLength": 1 },
                "memory": { "type": "string", "minLength": 1 }
              }
            },
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resources", "qosClass"],
              "properties": {
                "resources": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": { "type": "string", "minLength": 1 },
                    "memory": { "type": "string", "minLength": 1 }
                  }
                },
                "qosClass": { "enum": ["guaranteed", "burstable", "bestEffort"] }
              }
            }
          }
        },
        "tenantDashboardQuota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dashboardsPerAgent", "widgetsPerDashboard", "publish", "query"],
          "properties": {
            "dashboardsPerAgent": { "type": "integer", "minimum": 1 },
            "widgetsPerDashboard": { "type": "integer", "minimum": 1 },
            "publish": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requestBytes", "recordsPerRequest", "requestsPerMinutePerAgent", "acceptedBytesPerDay", "temporalRecordsPerDay", "retainedTemporalRecords", "latestBytesPerAgent"],
              "properties": {
                "requestBytes": { "type": "string", "minLength": 1 },
                "recordsPerRequest": { "type": "integer", "minimum": 1 },
                "requestsPerMinutePerAgent": { "type": "integer", "minimum": 1 },
                "acceptedBytesPerDay": { "type": "string", "minLength": 1 },
                "temporalRecordsPerDay": { "type": "integer", "minimum": 1 },
                "retainedTemporalRecords": { "type": "integer", "minimum": 1 },
                "latestBytesPerAgent": { "type": "string", "minLength": 1 }
              }
            },
            "query": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requestsPerMinutePerUser", "returnedCellsPerHour", "concurrentRequests", "cellsPerRequest", "responseBytes", "pointsPerSeries", "timeout"],
              "properties": {
                "requestsPerMinutePerUser": { "type": "integer", "minimum": 1 },
                "returnedCellsPerHour": { "type": "integer", "minimum": 1 },
                "concurrentRequests": { "type": "integer", "minimum": 1 },
                "cellsPerRequest": { "type": "integer", "minimum": 1 },
                "responseBytes": { "type": "string", "minLength": 1 },
                "pointsPerSeries": { "type": "integer", "minimum": 1 },
                "timeout": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "watchNamespace": { "type": "string" },
        "enableWebhooks": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "certManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "issuerName": { "type": "string", "minLength": 1 },
        "webhookCertificateName": { "type": "string", "minLength": 1 },
        "webhookSecretName": { "type": "string" }
      }
    },
    "extraArgs": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["Recreate", "RollingUpdate"] },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+%?$" }] },
            "maxSurge": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+%?$" }] }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+%?$" }] }
      }
    }
  }
}
