{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentz": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "umbrella": { "type": "boolean" } }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createSecret": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string", "minLength": 1 },
        "databaseURL": { "type": "string" }
      }
    },
    "manager": { "type": "object" },
    "gateway": { "type": "object" },
    "observer": { "type": "object" },
    "web": { "type": "object" },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host"],
            "properties": { "host": { "type": "string", "minLength": 1 } }
          }
        },
        "tls": { "type": "array" }
      }
    }
  }
}
