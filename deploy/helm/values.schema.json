{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": { "type": "string" },
        "agentz": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "umbrella": { "type": "boolean" } }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "serviceAccountName": {
          "type": "string"
        },
        "publicAddress": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ]
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gatewayURL": {
              "type": "string"
            },
            "internalK8sTokenAudience": {
              "type": "string"
            },
            "proxyCASecretName": {
              "type": "string"
            },
            "proxyCASecretKey": {
              "type": "string"
            },
            "agentTraceEndpoint": {
              "type": "string"
            },
            "skillsS3Endpoint": {
              "type": "string"
            },
            "skillsS3Region": {
              "type": "string"
            },
            "skillsS3Bucket": {
              "type": "string"
            }
          }
        }
      }
    },
    "spire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "trustDomain": {
          "type": "string"
        },
        "rootSecret": {
          "type": "string"
        },
        "publicAddress": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "storageSize": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "LoadBalancer",
                "NodePort"
              ]
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "maintenanceResources": { "type": "object" },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "manager": { "type": "object" },
    "gateway": { "type": "object" },
    "observer": { "type": "object" },
    "web": { "type": "object" },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host"],
            "properties": { "host": { "type": "string", "minLength": 1 } }
          }
        },
        "tls": { "type": "array" }
      }
    }
  }
}
