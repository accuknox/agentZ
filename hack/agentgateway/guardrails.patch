+#[derive(Serialize, Deserialize)]
+struct GuardrailErrorResponse {
+	error: GuardrailError,
+}
+
+/// Render a gateway-owned rejection in the client's API format.
+pub(crate) fn render_guardrail_response(
+	mut response: Response,
+	format: crate::llm::InputFormat,
+) -> Response {
+	let Some(error) = response.extensions().get::<GuardrailError>().cloned() else {
+		return response;
+	};
+	response.headers_mut().insert(
+		"x-agentgateway-guardrail-error",
+		::http::HeaderValue::from_static("true"),
+	);
+	let body = match format {
+		crate::llm::InputFormat::Messages => serde_json::json!({"type": "error", "error": error}),
+		_ => serde_json::json!({"error": error}),
+	};
+	*response.body_mut() = http::Body::from(body.to_string());
+	response
+		.headers_mut()
+		.remove(::http::header::CONTENT_LENGTH);
+	response
 }
 
