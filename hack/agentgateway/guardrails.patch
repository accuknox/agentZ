 impl RequestRejection {
+	fn structured_error(&self) -> Option<GuardrailError> {
+		serde_json::from_slice::<GuardrailErrorResponse>(&self.body)
+			.ok()
+			.map(|body| body.error)
+	}
+
+	fn describe_outcome(
+		&self,
+		action: GuardrailAction,
+		rejection: &mut Option<Response>,
+		detail: &mut Option<GuardDetail>,
+		checker_failed: bool,
+	) {
+		if action == GuardrailAction::Allow {
+			return;
+		}
+		let Some(mut error) = self.structured_error() else {
+			return;
+		};
+		let detail = detail.get_or_insert_with(GuardDetail::default);
+		if let Some(context) = &detail.context {
+			error.guardrail = context.clone();
+		}
+		if checker_failed {
+			error.guardrail.reason = Some(strng::literal!("checker_error"));
+			error.guardrail.matched_scope = None;
+			error.code = "guardrail_unavailable".into();
+			error.error_type = "api_error".into();
+			error.message = format!(
+				"Guardrail checker {} is unavailable",
+				error.guardrail.check_name
+			);
+		} else if matches!(
+			action,
+			GuardrailAction::Reject | GuardrailAction::Audit | GuardrailAction::Mask
+		) {
+			error.guardrail.reason = Some(strng::literal!("policy_violation"));
+		}
+		if !checker_failed && rejection.is_some() {
+			let scope = error
+				.guardrail
+				.matched_scope
+				.as_ref()
+				.or_else(|| (error.guardrail.scopes.len() == 1).then(|| &error.guardrail.scopes[0]));
+			let target = match scope.map(|scope| scope.as_str()) {
+				Some("instructions") => "System instructions",
+				Some("toolArguments") => "Tool inputs",
+				Some("toolResults") => "Tool results",
+				Some("conversation") if error.guardrail.phase.as_str() == "response" => {
+					"Assistant response"
+				},
+				Some("conversation") => "Chat messages",
+				_ if error.guardrail.phase.as_str() == "response" => "Model response",
+				_ => "Model request",
+			};
+			let policy = if error.guardrail.policy_name.is_empty() {
+				&error.guardrail.policy_id
+			} else {
+				&error.guardrail.policy_name
+			};
+			error.message = if policy.is_empty() {
+				format!("{target} blocked by policy")
+			} else {
+				format!("{target} blocked by policy named {policy:?}")
+			};
+			if !error.guardrail.message.is_empty() {
+				error.message.push_str(": ");
+				error.message.push_str(&error.guardrail.message);
+			}
+		}
+		detail.context = Some(error.guardrail.clone());
+		if rejection.is_some() {
+			let mut response = self.as_response();
+			response.headers_mut().insert(
+				::http::header::CONTENT_TYPE,
+				::http::HeaderValue::from_static("application/json"),
+			);
+			if checker_failed {
+				*response.status_mut() = StatusCode::SERVICE_UNAVAILABLE;
+			}
+			*response.body_mut() = http::Body::from(serde_json::json!({"error": error}).to_string());
+			response.extensions_mut().insert(error);
+			*rejection = Some(response);
+		}
+	}
+
