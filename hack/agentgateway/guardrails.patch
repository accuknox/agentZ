+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub(crate) struct GuardrailError {
+	#[serde(rename = "type")]
+	pub error_type: String,
+	pub code: String,
+	pub message: String,
+	#[serde(default)]
+	pub param: Option<String>,
+	pub guardrail: crate::cel::GuardrailContext,
