default(metadata.agentz_observability.agent_kind, "") in ["codex", "chatgpt-desktop"]
  ? default(request.headers["thread-id"], "")
  : (default(metadata.agentz_observability.agent_kind, "") in ["claude", "claude-desktop"]
      ? default(request.headers["x-claude-code-session-id"], "")
      : "")
