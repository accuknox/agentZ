{
  "name": "agentz-mobile",
  "version": "0.1.2",
  "main": "index.ts",
  "dependencies": {
    "@opencode-ai/sdk": "1.18.16",
    "@shopify/flash-list": "2.3.2",
    "cronstrue": "^3.38.0",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "heroui-native": "^1.0.11",
    "lucide-react-native": "^1.62.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-ai-animations": "0.9.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.0",
    "zod": "4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx Zed.tsx client.ts conversation.ts app.json package.json metro.config.js openapi-ts.config.mjs tsconfig.json global.css index.ts README.md",
    "gen:api": "openapi-ts",
    "build:apk": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a,x86_64 --no-daemon --max-workers=2",
    "lint": "eslint App.tsx Zed.tsx client.ts conversation.ts metro.config.js openapi-ts.config.mjs"
  },
  "private": true,
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "trailingComma": "es5"
  }
}
